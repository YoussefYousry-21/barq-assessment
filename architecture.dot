digraph BARQ {
  graph [rankdir=LR, label="BARQ assessment: final three-instance layout", labelloc=t];
  node [shape=box, style=rounded];

  client [label="Client\n127.0.0.1:8090"];
  nginx [label="NGINX\ncontainer port 80\n/health check"];
  app1 [label="app-01\nFlask :8080\n/health + /ready"];
  app2 [label="app-02\nFlask :8080\n/health + /ready"];
  app3 [label="app-03\nFlask :8080\n/health + /ready"];
  postgres [label="PostgreSQL :5432\nnamed postgres-data volume"];
  redis [label="Redis :6379\nAOF + named redis-data volume"];

  client -> nginx [label="published host port"];
  nginx -> app1 [label="frontend"];
  nginx -> app2 [label="frontend"];
  nginx -> app3 [label="frontend"];
  app1 -> postgres [label="backend"];
  app2 -> postgres [label="backend"];
  app3 -> postgres [label="backend"];
  app1 -> redis [label="backend"];
  app2 -> redis [label="backend"];
  app3 -> redis [label="backend"];
}
